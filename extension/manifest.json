{
  "manifest_version": 3,
  "name": "Helping Hands",
  "version": "0.1.0",
  "description": "Isolated-world Chrome map for Helping Hands. No CDP.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
