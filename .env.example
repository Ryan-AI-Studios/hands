# Copy to `.env` on this machine. `.env` is gitignored. None of these are
# required to `cargo build` or to click.

# do_task provider (one at a time). Named allowlisted host; starter IDs — re-verify.
# Default remains xAI grok-4.6. Missing key is a tool error, not a build failure.
# Prefer HANDS_KEY for any provider that needs a key; else the provider-specific env.

# default — today's behavior
# HANDS_DOTASK_PROVIDER=xai
# HANDS_DOTASK_MODEL=grok-4.6
# Hop timeout for every provider is still HANDS_XAI_TIMEOUT_MS (default 60000).
HANDS_KEY=

# OpenAI GPT-5.6 (prefer an explicit tier)
# HANDS_DOTASK_PROVIDER=openai
# HANDS_DOTASK_MODEL=gpt-5.6-terra
# OPENAI_API_KEY=

# Claude
# HANDS_DOTASK_PROVIDER=anthropic
# HANDS_DOTASK_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# Gemini
# HANDS_DOTASK_PROVIDER=google
# HANDS_DOTASK_MODEL=gemini-3.7-flash
# GEMINI_API_KEY=

# Ollama Cloud (~$20/mo Pro) or local daemon
# HANDS_DOTASK_PROVIDER=ollama
# HANDS_DOTASK_MODEL=gpt-oss:120b
# OLLAMA_API_KEY=
# HANDS_DOTASK_BASE_URL=http://127.0.0.1:11434   # local; omit for Cloud

# DeepSeek
# HANDS_DOTASK_PROVIDER=deepseek
# HANDS_DOTASK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=

# GLM-5.2 (Z.ai / BigModel)
# HANDS_DOTASK_PROVIDER=zhipu
# HANDS_DOTASK_MODEL=glm-5.2
# ZHIPU_API_KEY=

# Operator hint only — Hands does not read this. Sideload the unpacked
# extension on the Chrome profile you actually browse with (daily Chrome).
HANDS_CHROME_PROFILE=

# Optional pick/ground (loopback Gemma). 8081 down is a tool error.
# HANDS_GEMMA_URL=http://127.0.0.1:8081
