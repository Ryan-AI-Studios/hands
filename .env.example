# Copy to `.env` on this machine. `.env` is gitignored. None of these are
# required to `cargo build` or to click.

# do_task → xAI (Grok) at https://api.x.ai/v1/responses
# Prefer HANDS_KEY. Still accepted: HANDS_XAI_API_KEY, then XAI_API_KEY.
HANDS_KEY=

# Operator hint only — Hands does not read this. Sideload the unpacked
# extension on the Chrome profile you actually browse with (daily Chrome).
HANDS_CHROME_PROFILE=

# Optional pick/ground (loopback Gemma). 8081 down is a tool error.
# HANDS_GEMMA_URL=http://127.0.0.1:8081
